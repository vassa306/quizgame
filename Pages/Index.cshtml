@page
@using Newtonsoft.Json
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

@if (Model.Questions?.Any() == true)
{
    <form method="post">
        <input type="hidden" name="SerializedQuestions"
               value="@System.Net.WebUtility.HtmlEncode(JsonConvert.SerializeObject(Model.Questions))" />
        <br />
        <div class="mb-4">
            <label for="playerName" class="form-label fw-bold"><h5>Player </h5></label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="fa-solid fa-user"></i></span>
                <input type="text" id="playerName" name="PlayerName" class="form-control" placeholder="Enter your name" value="@Model.PlayerName" required />
            </div>
        </div>

        <div class="mt-4">
            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                var question = Model.Questions[i];

                <div class="mb-4 border rounded p-3 shadow-sm">
                    <h5>@(i + 1). @Html.Raw(question.Question)</h5>
                    <p>
                        <small style="color:gray;">
                            Answers count: <strong>@question.AllAnswers?.Count</strong> |
                            Distinct: <strong>@(question.AllAnswers?.Distinct().Count())</strong> |
                            IsMultipleChoice: <strong>@(question.IsMultipleChoice)</strong>
                        </small>
                    </p>

                    @if (question.IsMultipleChoice)
                    {
                        @for (int j = 0; j < question.AllAnswers.Count; j++)
                        {
                            var answer = question.AllAnswers[j];
                            var inputId = $"q{i}_a{j}";
                            <div class="form-check">
                                <input class="form-check-input" type="radio"
                                       name="Answers[@i]"
                                       id="@inputId"
                                       value="@answer"
                                       @(Model.Answers?.ElementAtOrDefault(i) == answer ? "checked" : "") />

                                <label class="form-check-label" for="@inputId">
                                    @Html.Raw(answer)
                                </label>
                            </div>
                        }
                    }
                    else
                    {
                        <input type="text" name="Answers[@i]" class="form-control" placeholder="Your answer here..."
                               value="@Model.Answers?.ElementAtOrDefault(i)" />
                    }
                    @if (Model.Score != null && i < Model.Answers?.Count)
                    {
                        var isCorrect = string.Equals(Model.Answers[i]?.Trim(), question.Correct_Answer?.Trim(), StringComparison.OrdinalIgnoreCase);
                        <p class="mt-2 text-@(isCorrect ? "success" : "danger")">
                            @(isCorrect ? "Correct!" : $"Wrong! Correct answer was: {question.Correct_Answer}")
                        </p>
                    }

                </div>
            }
        </div>

        <div class="text-center mt-3">
            <button type="submit" asp-page-handler="SubmitAnswers" class="btn btn-primary">Submit Answers</button>
        </div>

        @if (Model.Score != null)
        {
            <div class="alert alert-info mt-4">
                Your score: Dear player <strong>@Model.PlayerName</strong> <strong>@Model.Score</strong> out of @Model.Questions.Count
            </div>
        }
    </form>
}
else if (!ViewContext.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}
else
{
    <div class="text-center mt-4">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p>Loading questions...</p>
    </div>
}
