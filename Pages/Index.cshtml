@page
@using Newtonsoft.Json
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<br />
@{
    int total = Model.Questions?.Count ?? 0;
    int answered = Model.Answers?.Count(a => !string.IsNullOrWhiteSpace(a)) ?? 0;
    int percent = total > 0 ? (int)((double)answered / total * 100) : 0;
}

<div class="progress mb-4">
    <div id="progressBar" class="progress-bar gradient-bar" role="progressbar" style="width: 0%;">
        0 of @Model.Questions.Count answered
    </div>
</div>

@if (Model.Questions?.Any() == true)
{
    <form method="post">
        <input type="hidden" name="SerializedQuestions"
               value="@System.Net.WebUtility.HtmlEncode(JsonConvert.SerializeObject(Model.Questions))" />
        <br />
        <div class="mb-4">
            <label for="playerName" class="form-label fw-bold"><h5>Player </h5></label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="fa-solid fa-user"></i></span>
                <input type="text" id="playerName" name="PlayerName" class="form-control" placeholder="Enter your name" value="@Model.PlayerName" required />
            </div>
        </div>

        <div class="mt-4">
            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                var question = Model.Questions[i];

                <div class="mb-4 border rounded p-3 shadow-sm question-box">
                    <h5>@(i + 1). @Html.Raw(question.Question)</h5>
                    @if (question.IsMultipleChoice)
                    {
                        @for (int j = 0; j < question.AllAnswers.Count; j++)
                        {
                            var answer = question.AllAnswers[j];
                            var inputId = $"q{i}_a{j}";
                            <div class="form-check">
                                <input class="form-check-input" type="radio"
                                       name="Answers[@i]"
                                       id="@inputId"
                                       value="@answer"
                                       @(Model.Answers?.ElementAtOrDefault(i) == answer ? "checked" : "") />

                                <label class="form-check-label" for="@inputId">
                                    @Html.Raw(answer)
                                </label>
                            </div>
                        }
                    }
                    else
                    {
                        <input type="text" name="Answers[@i]" class="form-control" placeholder="Your answer here..."
                               value="@Model.Answers?.ElementAtOrDefault(i)" />
                    }
                    @if (Model.Score != null && i < Model.Answers?.Count)
                    {
                        var isCorrect = string.Equals(Model.Answers[i]?.Trim(), question.Correct_Answer?.Trim(), StringComparison.OrdinalIgnoreCase);
                        <p class="mt-2 text-@(isCorrect ? "success" : "danger")">
                            @(isCorrect ? "Correct!" : Html.Raw($"Wrong! Correct answer was: {question.Correct_Answer}"))
                        </p>
                    }

                </div>
            }
        </div>

        <button type="submit" id="submitBtn" asp-page-handler="SubmitAnswers" class="btn btn-primary btn-lg" disabled>
            Submit Answers
        </button>

        @if (Model.Score != null)
        {
            <div class="alert alert-info mt-4">
                Your score: Dear player <strong>@Model.PlayerName</strong> <strong>@Model.Score</strong> out of @Model.Questions.Count
            </div>
        }
    </form>
}
else if (!ViewContext.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewContext.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}
else
{
    <div class="text-center mt-4">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p>Loading questions...</p>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const inputs = document.querySelectorAll("input[type='radio'], input[type='text']");
            const progressBar = document.getElementById("progressBar");
            const submitBtn = document.getElementById("submitBtn");

            function updateProgressBar() {
                const answered = [...inputs]
                    .filter(input => (input.type === "radio" && input.checked) ||
                                     (input.type === "text" && input.value.trim() !== ""))
                    .map(input => input.name.match(/\d+/)?.[0])
                    .filter((v, i, a) => v && a.indexOf(v) === i);

                const total = @Model.Questions.Count;
                const percent = Math.round((answered.length / total) * 100);
                progressBar.style.width = percent + "%";
                progressBar.innerText = `${answered.length} of ${total} answered`;

                submitBtn.disabled = answered.length !== total;
            }

            inputs.forEach(input => {
                input.addEventListener("input", updateProgressBar);
            });

            updateProgressBar();
        });
    </script>
}

